[package]
name = "@@PACKAGE_NAME@@"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]

[lib]
crate-type = ["staticlib"]

[dependencies]
mirui = { version = "{{mirui-version}}", git = "https://github.com/W-Mai/mirui", rev = "@@MIRUI_REV@@", features = ["wgpu"] }
@@APP_DEPENDENCY@@
@@RELEASE_PROFILE@@
