[package]
name = "@@PACKAGE_NAME@@"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]

[features]
default = []
quad-aa = ["mirui/quad-aa"]
perf = ["mirui/perf"]

[dependencies]
mirui = { version = "{{mirui-version}}", default-features = false }
@@APP_DEPENDENCY@@

esp-hal = { version = "1.1.0", features = ["esp32c3", "unstable"] }
esp-alloc = "0.7"
esp-println = { version = "0.14", features = ["esp32c3"] }
esp-bootloader-esp-idf = { version = "0.5.0", features = ["esp32c3"] }

critical-section = "1.2"
@@RELEASE_PROFILE@@
