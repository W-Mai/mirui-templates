[package]
name = "@@PACKAGE_NAME@@"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]

[lib]
crate-type = ["cdylib"]

[dependencies]
mirui = { version = "{{mirui-version}}", default-features = false, features = ["web-canvas"] }
@@APP_DEPENDENCY@@

[target.'cfg(target_arch = "wasm32")'.dependencies]
wasm-bindgen = "0.2.122"
web-sys = { version = "0.3.99", features = ["Document", "HtmlCanvasElement", "Window"] }
console_error_panic_hook = "0.1"
@@RELEASE_PROFILE@@
