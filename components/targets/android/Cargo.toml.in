[package]
name = "@@PACKAGE_NAME@@"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]

[lib]
crate-type = ["cdylib"]

[dependencies]
mirui = { version = "{{mirui-version}}", git = "https://github.com/W-Mai/mirui", rev = "@@MIRUI_REV@@", features = ["wgpu-android"] }
winit = { version = "0.30", features = ["android-native-activity"] }
@@APP_DEPENDENCY@@

[package.metadata.android]
package = "{{android-package}}"
build_targets = ["aarch64-linux-android"]

[package.metadata.android.sdk]
min_sdk_version = 26
target_sdk_version = 35

[package.metadata.android.application]
label = "{{project-name}}"
@@RELEASE_PROFILE@@
