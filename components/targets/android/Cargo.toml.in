[package]
name = "@@PACKAGE_NAME@@"
version = "0.1.0"
edition = "2024"
authors = ["{{authors}}"]

[lib]
name = "mirui_android"
crate-type = ["cdylib"]

[dependencies]
mirui = { version = "{{mirui-version}}", features = ["wgpu-android"] }
winit = { version = "0.30", features = ["android-native-activity"] }
@@APP_DEPENDENCY@@

@@RELEASE_PROFILE@@
